{
  "name": "@misomoon/sdk",
  "version": "0.1.0",
  "description": "misomoon analytics for browsers, React, Next.js, React Native and Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackzard/misomoon.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/jackzard/misomoon/blob/main/docs/sdk.md",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "react-native"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/esm/web.d.ts",
        "default": "./dist/esm/web.js"
      },
      "require": {
        "types": "./dist/cjs/web.d.ts",
        "default": "./dist/cjs/web.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/esm/react-native.d.ts",
        "default": "./dist/esm/react-native.js"
      },
      "require": {
        "types": "./dist/cjs/react-native.d.ts",
        "default": "./dist/cjs/react-native.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.ts",
        "default": "./dist/esm/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "web": [
        "./dist/cjs/web.d.ts"
      ],
      "react": [
        "./dist/cjs/react.d.ts"
      ],
      "react-native": [
        "./dist/cjs/react-native.d.ts"
      ],
      "node": [
        "./dist/cjs/node.d.ts"
      ],
      "next": [
        "./dist/cjs/next.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}\\n')\"",
    "check": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@misomoon/core": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
