{
  "name": "misomoon",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "bundle": "pnpm --filter @misomoon/api bundle",
    "db:migrate": "pnpm --filter @misomoon/api db:migrate",
    "db:seed": "pnpm --filter @misomoon/api db:seed"
  },
  "engines": { "node": ">=22.5" }
}
