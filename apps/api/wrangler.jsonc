{
	// The self-hosted template: `pnpm --filter @misomoon/api run deploy` deploys a new
	// misomoon server from it (docs/self-hosting.md), and `pnpm bundle` builds the Deploy to
	// Cloudflare bundle from it. misomoon Cloud's own config is wrangler.cloud.jsonc.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "misomoon-api",
	"main": "src/index.ts",
	// The deploy prints the workers.dev address. For your own domain, add a route
	// (docs/self-hosting.md#use-your-own-domain).
	"workers_dev": true,
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_compat"],
	// Invocation logs and traces would keep request metadata for every beacon (user agent,
	// full URL, city, network); the code logs its own events, never an IP address.
	"observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } },
	"rules": [{ "type": "Text", "globs": ["**/*.min.js"], "fallthrough": true }],
	// The dashboard is a static SPA served from this Worker. The Worker runs first for
	// every path so a customer's proxy hostname serves only the tracker, never the app.
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// Placeholder ids: the first deploy (scripts/deploy.ts) creates each database and
	// writes its id here. Commit the file after that deploy.
	"d1_databases": [
		{ "binding": "CONTROL", "database_name": "misomoon-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/control" },
		// Event shards, managed by `SHARD_COUNT=<n> pnpm run deploy` (scripts/deploy.ts).
		{ "binding": "SHARD_0", "database_name": "misomoon-shard-0", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations/shard" },
		{ "binding": "SHARD_1", "database_name": "misomoon-shard-1", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations/shard" }
	],
	"queues": {
		"producers": [{ "binding": "EVENTS", "queue": "misomoon-events" }],
		"consumers": [{ "queue": "misomoon-events", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "misomoon-events-dlq" }]
	},
	// Stats API calls, and sign-in attempts: 100 per key or IP per minute across all isolates.
	"ratelimits": [
		{ "name": "STATS_LIMIT", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
	],
	// Browser Run prints the PDF attached to weekly and monthly reports. Without it, reports
	// go out without the PDF. Local dev can't print (quick actions run remotely only).
	"browser": { "binding": "BROWSER" },
	"triggers": { "crons": ["*/5 * * * *"] },
	// docs/configuration.md#variables explains each one.
	"vars": {
		"SHARD_SOFT_LIMIT_MB": "8000",
		// Keep everything until you set a limit.
		"RETENTION_DAYS": "0",
		"RETENTION_DEFAULT_DAYS": "",
		// No demo site, so the dashboard opens your first site, and no sample site.
		"DEMO_SITE": "",
		"SAMPLE_SITE": "",
		// The first account can sign up and owns the server; everyone after it needs an invitation.
		"SIGNUPS": "invite"
		// Links in emails the cron and the queue send: set PUBLIC_URL to your dashboard's
		// address, like "https://analytics.example.com".
	}
	// Secrets: AWS_SES_ACCESS_KEY_ID and AWS_SES_SECRET_ACCESS_KEY for Amazon SES (wrangler secret put …, or .dev.vars locally).
	// Managed proxy (optional, docs/PROXY.md): secret CF_API_TOKEN, vars CF_ZONE_ID and
	// PROXY_CNAME_TARGET, plus a route for customer hostnames: { "pattern": "*/*", "zone_name": … }.
}
