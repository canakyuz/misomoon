{
  "name": "@misomoon/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev --port 5174",
    "build": "vp build",
    "preview": "wrangler dev",
    "deploy": "vp build && wrangler deploy && wrangler d1 migrations apply CONTENT --remote",
    "db:migrate": "wrangler d1 migrations apply CONTENT --local",
    "content": "node --experimental-strip-types scripts/content.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@misomoon/brand": "workspace:*",
    "@misomoon/core": "workspace:*",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.152.0"
  }
}
